<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <Authors>Nuv Tools</Authors>
	  <Copyright>Copyright © 2026 Nuv Tools</Copyright>
	  <PackageProjectUrl>https://nuvtools.com</PackageProjectUrl>
	  <Description>Typed client for Stripe, covering customers and saved payment methods, Connect Express onboarding, separate charges and transfers, and webhook signature verification. Wraps the official Stripe.net SDK and returns NuvTools.Common ResultWrapper results.</Description>
	  <Version>10.0.0</Version>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	  <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
	  <PackageIcon>icon.png</PackageIcon>
	  <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	  <PackageLicenseFile>LICENSE</PackageLicenseFile>
	  <RepositoryUrl>https://github.com/nuvtools/nuvtools-payment</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
	  <AnalysisLevel>latest</AnalysisLevel>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageTags>NuvTools Payment Stripe ApiClient Connect Marketplace Webhooks</PackageTags>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <RootNamespace>NuvTools.Payment.Stripe.ApiClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png">
      <Link>icon.png</Link>
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Link>LICENSE</Link>
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The contracts this package implements. A caller references NuvTools.Payment and never this
         package, except in its composition root. -->
    <ProjectReference Include="..\NuvTools.Payment\NuvTools.Payment.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The official SDK. It owns the wire format, the API version this build is pinned to, and the
         webhook signature check — three things that are expensive to get subtly wrong by hand.

         What this package does not take is NuvTools.Payment's resilient HttpClient helper, unlike its
         siblings. That helper is for hand-rolled typed clients; Stripe's SDK retries on its own, and
         it is the one that re-sends a request's idempotency key when it does — which a generic retry
         handler in front of it would not guarantee for a call that moves money. -->
    <PackageReference Include="Stripe.net" Version="52.4.2" />
    <PackageReference Include="NuvTools.Common" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
  </ItemGroup>

</Project>
