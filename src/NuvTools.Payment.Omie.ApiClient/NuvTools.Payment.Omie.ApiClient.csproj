<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net10.0</TargetFrameworks>
	  <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	  <Authors>Nuv Tools</Authors>
	  <Copyright>Copyright © 2026 Nuv Tools</Copyright>
	  <PackageProjectUrl>https://nuvtools.com</PackageProjectUrl>
	  <Description>Typed HTTP client for the Omie ERP API. Supports client lookup, service registration query, service order (OS) creation, accounts receivable entries, and bank slip (boleto) generation. Returns NuvTools.Common ResultWrapper results.</Description>
	  <Version>10.2.0</Version>
	  <GenerateDocumentationFile>True</GenerateDocumentationFile>
	  <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
	  <PackageIcon>icon.png</PackageIcon>
	  <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	  <PackageLicenseFile>LICENSE</PackageLicenseFile>
	  <RepositoryUrl>https://github.com/nuvtools/nuvtools-payment</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>
	  <AnalysisLevel>latest</AnalysisLevel>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageTags>NuvTools Payment Omie ERP ApiClient Brazil Boleto Receivable ServiceOrder Invoicing</PackageTags>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png">
      <Link>icon.png</Link>
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Link>LICENSE</Link>
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NuvTools.Payment.Omie.ApiClient.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NuvTools.Common" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Fields.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Fields.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\Messages.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Messages.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Fields.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Fields.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Messages.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Messages.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
